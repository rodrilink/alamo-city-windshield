# Supabase — safe to be NEXT_PUBLIC_ (anon key is designed for browser use; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — NEVER add NEXT_PUBLIC_ prefix (service role bypasses ALL RLS — if leaked, entire DB is exposed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Business phone — NOT a secret (NEXT_PUBLIC_* is inlined into the client bundle
# and the number is shown in the header, footer and every "call us" message).
# It lives here only to keep the real number out of a public git repository.
# Format it exactly as it should be displayed; the tel: link is derived from it.
# If unset, the app falls back to a reserved-fictional 555 number so a missing
# config is visibly wrong rather than silently blank.
NEXT_PUBLIC_BUSINESS_PHONE=(210) 555-0100
